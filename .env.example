# Copy this file to .env, replace every placeholder, and keep .env private.
# Quote the URL if its password contains shell characters.
DATABASE_URL='postgresql://unilost_backend:URL_ENCODED_PASSWORD@DB_HOST:5432/postgres?sslmode=require'

# The Supabase publishable/anon key is designed for browser use. The C server
# sends it to Auth and returns it only to the local frontend configuration API.
SUPABASE_URL='https://YOUR_PROJECT_REF.supabase.co'
SUPABASE_ANON_KEY='YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY'
